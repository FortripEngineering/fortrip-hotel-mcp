{
  "name": "fortrip-mcp",
  "version": "0.1.1",
  "description": "Fortrip hotel search, live rates and booking payment links over MCP stdio",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "fortrip-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "npm run build && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-build/*.test.js",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "guides",
    "LICENSE",
    "README.md",
    "docs",
    "examples"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FortripEngineering/fortrip-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/FortripEngineering/fortrip-mcp/issues"
  },
  "keywords": [
    "mcp",
    "hotel",
    "travel",
    "fortrip"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
